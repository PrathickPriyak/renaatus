# Copy to `.env.local` for local development.
# Never commit real secrets. Never use production credentials in development.

# --- App ---
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (server-side only; never prefix with NEXT_PUBLIC_) ---
# Required to run Prisma Client / migrations. Never commit real values.
# Local example (replace USER, PASSWORD, HOST, DATABASE):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Neon / serverless: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
# Apply schema changes with `npm run db:deploy` (production) or `npm run db:migrate` (dev).
# Never run `prisma migrate reset` against a shared or production database.
DATABASE_URL=
DIRECT_URL=

# --- Staff sessions (database sessions; never expose to the browser) ---
# Used to sign private resume download tokens and hash client IPs.
# Required in production. Generate with: openssl rand -base64 32
# Use at least 32 characters in production.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# First administrator (local/bootstrap only; never commit real values):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# --- Email (Resend) ---
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=

# --- Cloudflare Turnstile ---
# Required in production. Enquiry forms fail closed without TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (rate limiting) ---
# Required in production. Login and enquiry rate limits fail closed without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging ---
LOG_LEVEL=debug
