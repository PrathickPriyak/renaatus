// Proposed production schema — not wired into the app in this phase.
// Target: PostgreSQL + Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum EnquiryKind {
  CONTACT
  PRODUCT
  PROJECT
  CAREER
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProjectType {
  REALTY
  INFRASTRUCTURE
}

enum Industry {
  AVIATION
  HEALTHCARE
  WATER
  TRANSPORT
  CIVIC
  RESIDENTIAL
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  posts    Post[]
  audits   AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Media {
  id          String          @id @default(cuid())
  key         String          @unique
  bucket      String
  filename    String
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  alt         String?
  visibility  MediaVisibility @default(PUBLIC)
  createdAt   DateTime        @default(now())
  createdById String?

  featuredPosts    Post[]          @relation("PostFeatured")
  featuredProjects Project[]       @relation("ProjectCover")
  featuredProducts Product[]       @relation("ProductCover")
  projectImages    ProjectImage[]
  resumes          Enquiry[]       @relation("EnquiryResume")
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  posts PostTag[]
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @db.Text
  body           Json
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  featuredImageId String?
  featuredImage   Media?  @relation("PostFeatured", fields: [featuredImageId], references: [id])
  tags            PostTag[]

  @@index([status, publishedAt])
  @@index([authorId])
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  summary        String   @db.Text
  body           Json?
  published      Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  coverId        String?
  cover          Media?   @relation("ProductCover", fields: [coverId], references: [id])
  enquiries      Enquiry[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        ProjectType
  industry    Industry
  country     String
  location    String
  year        Int?
  summary     String      @db.Text
  body        Json?
  published   Boolean     @default(false)
  coverId     String?
  cover       Media?      @relation("ProjectCover", fields: [coverId], references: [id])
  images      ProjectImage[]
  enquiries   Enquiry[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, published])
  @@index([industry, published])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  mediaId   String
  sortOrder Int    @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id])

  @@index([projectId, sortOrder])
}

model Enquiry {
  id        String         @id @default(cuid())
  kind      EnquiryKind
  status    EnquiryStatus  @default(NEW)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String         @db.Text
  office    String?
  sourcePath String?
  ipHash    String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  resumeId  String?
  resume    Media?   @relation("EnquiryResume", fields: [resumeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
